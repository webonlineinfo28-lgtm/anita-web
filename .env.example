# Copia este fichero como .env y rellena los valores que quieras.

# Contraseña para acceder como HOST (propietario del festival).
# Si no defines ninguna, se usa "uwu777" como fallback.
VITE_ADMIN_PASSWORD=

# OPCIONAL — Sincronización multidispositivo GRATIS con Supabase.
# Crea un proyecto gratis en supabase.com, ejecuta el SQL del README en el
# SQL Editor y pega aquí la URL y la anon key del proyecto.
# Sin estas claves la app funciona igual (sincroniza pestañas del mismo navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=