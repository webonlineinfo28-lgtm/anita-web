# ============================================================
# ANITA FESTIVAL 2.0 - Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores

# ============================================================
# SEGURIDAD
# ============================================================
# Contraseña para ser HOST (administrador del festival)
# Cambia esta contraseña para mayor seguridad
VITE_ADMIN_PASSWORD=uwu.777

# ============================================================
# SUPABASE - Sincronizacion multidispositivo (OPCIONAL)
# ============================================================
# Sin estas variables, la app funciona perfectamente
# sincronizando solo pestañas del mismo navegador.
# 
# Para activar sincronizacion entre dispositivos:
# 1. Crea proyecto en https://supabase.com
# 2. Ve a Settings > API
# 3. Copia Project URL y anon/public key
# 4. Ejecuta el SQL en supabase/migrations/001_create_festival_state.sql
# 5. Rellena los valores abajo

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
